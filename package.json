{
  "name": "sticky-harness",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Minimal desktop sticky notes with a local AI harness status panel.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
