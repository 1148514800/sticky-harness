{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Base capability applied to every note window, the harness task window and the adapter window.",
  "windows": [
    "note-*",
    "harness-tasks",
    "harness-adapters"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-set-size",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "opener:default"
  ]
}
